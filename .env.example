# Neon Postgres (Neon Console -> Connection details)
# Pulled automatically by `neon link` / `neon deploy` into .env.local; this file is just a reference.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Neon Console -> Auth -> Configuration), configured per branch
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# App-generated, 32+ chars. Signs the cached session cookie. Not written by neon link.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Crossway ESV API key (free): https://api.esv.org/account/create-application/
# Without it, verse tokens are kept in the note but render as "Couldn't find".
ESV_API_KEY=
